# ============================================================
# 文美全球AI获客系统 — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit real API keys or email passwords.
# ============================================================

# --- LLM Model (LiteLLM format) ---
LLM_MODEL=minimax/MiniMax-M2.1-highspeed
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_REQUESTS_PER_MINUTE=60

# --- Reasoning Model ---
REASONING_MODEL=minimax/MiniMax-M2.5
REASONING_TEMPERATURE=0.2
REASONING_MAX_TOKENS=4096
REASONING_REQUESTS_PER_MINUTE=60

# --- LLM Provider API Keys ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ZAI_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.io/v1

# --- Search / Web extraction ---
SERPER_API_KEY=
TAVILY_API_KEY=
JINA_API_KEY=

# --- Email ---
EMAIL_FROM_NAME=文美全球AI获客系统
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_AUTO_SEND_ENABLED=false
EMAIL_REPLY_DETECTION_ENABLED=false
EMAIL_REQUIRE_APPROVAL_BEFORE_SEND=true
EMAIL_LLM_MODEL=
EMAIL_REASONING_MODEL=
EMAIL_LLM_REQUESTS_PER_MINUTE=0
EMAIL_REASONING_REQUESTS_PER_MINUTE=0

# --- Langfuse (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=false

# --- Hunt Defaults ---
DEFAULT_TARGET_LEAD_COUNT=200
DEFAULT_MAX_ROUNDS=10
DEFAULT_KEYWORDS_PER_ROUND=8
MIN_NEW_LEADS_THRESHOLD=5

# --- Concurrency ---
SEARCH_CONCURRENCY=10
SCRAPE_CONCURRENCY=5
EMAIL_GEN_CONCURRENCY=3
REACT_MAX_ITERATIONS=5

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
API_ACCESS_TOKEN=
SETTINGS_API_ENABLED=true

# --- Database / Uploads ---
CHECKPOINT_DB_PATH=hunt_sessions.db
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# --- Automation ---
AUTOMATION_FEISHU_WEBHOOK_URL=
AUTOMATION_EMBEDDED_CONSUMER_ENABLED=true
AUTOMATION_TEMPLATE_SEED_PREWARM_ENABLED=true
AUTOMATION_CONSUMER_AUTO_START_CAMPAIGN=true
AUTOMATION_SUMMARY_ENABLED=true
AUTOMATION_SUMMARY_INTERVAL_SECONDS=7200
AUTOMATION_ALERTS_ENABLED=true
AUTOMATION_ALERT_INTERVAL_SECONDS=1800
AUTOMATION_ALERT_BACKLOG_THRESHOLD=20
AUTOMATION_ALERT_FAILED_MESSAGES_THRESHOLD=10
AUTOMATION_EVENT_NOTIFICATIONS_ENABLED=true
AUTOMATION_DISCOVERY_BATCH_SIZE=5
AUTOMATION_SEND_BATCH_SIZE=10
AUTOMATION_EVENT_FLUSH_INTERVAL_SECONDS=600
